# Local development template for VFR.AiEngine
# Aspire injects a tcp:// Redis endpoint; for direct local runs use redis://.

REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=https://<your-s3-endpoint>
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_BUCKET_NAME=vfr-3d-assets
AVATAR_STORAGE_BASE=https://storage.example.com/models
AI_ENGINE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
GRPC_PORT=50051
OMP_NUM_THREADS=1
RUN_WORKER=false
